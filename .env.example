NEBIUS_API_KEY=<YOUR_NEBIUS_TOKEN_FACTORY_KEY>
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/   # VERIFY against current Nebius docs
NVIDIA_API_KEY=<YOUR_NVIDIA_API_KEY>                       # build.nvidia.com; needed for audio (Token Factory takes text/image/video only)
PERCEPTION_PROVIDER=nvidia                                 # nebius (default) or nvidia, per role: PATCH_PROVIDER, ESCALATION_PROVIDER
PERCEPTION_THINKING_BUDGET=2048                            # cap Omni's thinking tokens: faster, fewer 504s (unset = no cap)
MODEL_PERCEPTION=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning   # Nemotron 3 Nano Omni: sees video and hears its soundtrack
MODEL_PATCH=<NEMOTRON_3_SUPER_MODEL_ID>
MODEL_ESCALATION=<NEMOTRON_3_ULTRA_MODEL_ID>
TAVILY_API_KEY=<YOUR_TAVILY_KEY>
# USD per 1M tokens. Nebius: tokenfactory.nebius.com/model-catalog.md (Super 0.30/0.90, Ultra 1.00/3.00).
# Perception on NVIDIA's API has no published per-token price (free trial credits), so 0.
PRICE_PER_1M_INPUT_PERCEPTION=0
PRICE_PER_1M_OUTPUT_PERCEPTION=0
PRICE_PER_1M_INPUT_PATCH=0.30
PRICE_PER_1M_OUTPUT_PATCH=0.90
PRICE_PER_1M_INPUT_ESCALATION=1.00
PRICE_PER_1M_OUTPUT_ESCALATION=3.00
RATE_LIMIT_ANALYSES_PER_HOUR=6
DEMO_MODE_CACHE=true
